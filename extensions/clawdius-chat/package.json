{
  "name": "clawdius-chat",
  "publisher": "vscode",
  "displayName": "Clawdius Chat",
  "description": "The Clawdius default chat participant, powered by the local Claude Code CLI.",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatParticipantAdditions"
  ],
  "main": "./out/extension",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "gulp compile-extension:clawdius-chat",
    "watch": "gulp watch-extension:clawdius-chat"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "vscode.clawdius-chat.default",
        "name": "clawdius",
        "fullName": "Clawdius",
        "description": "Build with Clawdius",
        "isDefault": true,
        "locations": [
          "panel"
        ],
        "modes": [
          "ask",
          "edit",
          "agent"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chapmanjw/clawdius.git"
  }
}
