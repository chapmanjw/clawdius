{
  "name": "clawdius-chat",
  "publisher": "vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatParticipantAdditions",
    "chatProvider"
  ],
  "main": "./out/extension",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:clawdius.hasClaudeCredentials",
    "onCommand:clawdius.refreshUsageCapacity"
  ],
  "scripts": {
    "compile": "gulp compile-extension:clawdius-chat",
    "watch": "gulp watch-extension:clawdius-chat"
  },
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "clawdius",
        "displayName": "%lmProvider.displayName%"
      }
    ],
    "chatParticipants": [
      {
        "id": "vscode.clawdius-chat.default",
        "name": "clawdius",
        "fullName": "Clawdius",
        "description": "%participant.description%",
        "isDefault": true,
        "locations": [
          "panel"
        ],
        "modes": [
          "ask",
          "edit",
          "agent"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chapmanjw/clawdius.git"
  }
}
